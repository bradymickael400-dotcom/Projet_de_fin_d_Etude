FLASK_APP=run.py
FLASK_ENV=development
SECRET_KEY=change-moi-en-production
ARTHENA_SECRET_KEY=
POSTGRES_DB=arthena
POSTGRES_USER=arthena
POSTGRES_PASSWORD=changez-ce-mot-de-passe
SEED_DEMO_DATA=false
PAYMENT_SIMULATION=false
ALLOWED_ORIGINS=

# Gmail : utilisez un mot de passe d'application, jamais votre mot de passe normal.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# Laisser DATABASE_URL vide en dev : app/config.py calcule automatiquement
# un chemin SQLite absolu vers instance/arthena.db.
# DATABASE_URL=
#
# En production, utiliser PostgreSQL :
# DATABASE_URL=postgresql://user:password@localhost:5432/arthena
